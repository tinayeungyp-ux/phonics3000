{
  "version": 1,
  "bonusWords": "spellable=false → 'bonus word': the card shows the English + chunks for reading/listening, but the word is never used in spelling practice or dictation (romanised names such as siu mai, oden, dango). All other words are spellable.",
  "chunkRules": [
    "chunks = syllable chunks shown on the card as 'piz · za'; one-syllable words are a single chunk",
    "sounds = grapheme (phoneme-letter) units, UK Letters-and-Sounds style; split digraphs written a_e / i_e; shown for 1-syllable words (c · a_e · k)",
    "never split a digraph/trigraph (ch, sh, ck, ng, oo, ee, ai, ur, er, or, aw...)",
    "doubled consonants split between syllables: ap·ple, piz·za, pud·ding, jel·ly, cher·ry",
    "consonant-le stays together: ap·ple, waf·fle",
    "long/open first vowel -> V/CV (ba·na·na, su·shi, ta·co); short/closed -> VC/V (mel·on, sal·ad)",
    "compounds and two-word names split on the word boundary first (straw·ber·ry, pop·corn, ice cream)"
  ],
  "levels": {
    "easy": "1–2 regular chunks, mostly single-letter sounds",
    "medium": "digraphs, split digraphs, doubled letters or two words",
    "hard": "3+ syllables, loanword spelling, or tricky/irregular parts"
  },
  "completionRule": {
    "complete": "A category is complete when all 8 of its foods have been collected at least once. The title is awarded immediately on the 8th new card.",
    "drops": "1 food per finished practice session (streak/perfect bonus = +1 extra draw, max 2 a day from bonuses).",
    "newCardBias": "Draws favour uncollected foods: guarantee a NEW card at least every 3rd draw until the album is full.",
    "duplicates": "Duplicates still feed 拼拼 and add ×2, ×3 counters on the card – no wasted rewards, no loss mechanics.",
    "levelGate": "Optional: hard-level foods only drop after a session with ≥80% correct, so the rarest cards line up with the hardest words.",
    "stretch": "Optional gold-frame 'mastered' stamp per card when the child has spelled that food word correctly once (tap card → mini spell).",
    "allComplete": {
      "title": "拼拼美食家",
      "title_en": "Pingo's Food Critic",
      "rule": "all 7 categories complete"
    }
  },
